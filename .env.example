# 博客系统环境配置示例

# 环境设置 (development/production)
ENVIRONMENT=development

# 安全密钥 (生产环境必须设置，使用强随机密码)
# 可以使用以下命令生成: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=your_secure_random_secret_key_here

# 数据库配置 (可选，默认使用SQLite)
# DATABASE_URL=postgresql://user:pass@localhost/dbname

# SocketIO 允许的来源 (多个用逗号分隔)
SOCKETIO_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8080

# 注意：不要将这个文件提交到版本控制系统！
